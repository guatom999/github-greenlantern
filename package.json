{
  "name": "github-greenlantern",
  "version": "1.0.0",
  "description": "Turn a seven-row GitHub contribution calendar into a glowing Green Lantern animation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "github-greenlantern": "build/bin/greenlantern.js"
  },
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "default": "./build/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node build/scripts/copy-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "npm run build && node --test build/test/*.test.js",
    "demo": "npm run build && node build/bin/greenlantern.js --user demo --fixture fixtures/demo.json --output examples",
    "generate": "npm run build && node build/bin/greenlantern.js",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guatom999/github-greenlantern.git"
  },
  "files": [
    "build/src",
    "build/bin",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
